model User {
    id        Int     @id @default(autoincrement())
    username  String  @unique
    password  String
    email     String? @unique
    firstName String?
    lastName  String?
    roleId    Int

    role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
    articles Article[]
}

model Role {
    id   Int    @id @default(autoincrement())
    name String @unique

    permissions RolePermission[]
    users       User[]
}

model RolePermission {
    id        Int     @id @default(autoincrement())
    roleId    Int
    section   String
    canView   Boolean
    canEdit   Boolean
    canDelete Boolean

    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
}
