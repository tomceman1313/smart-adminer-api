model Article {
    id                  Int      @id @default(autoincrement())
    title               String
    description         String
    imageId             Int
    body                String
    publishedAtDateTime DateTime
    isVisible           Boolean
    createdBy           Int
    position            Int

    tags                  ArticleTag[]
    attachedFiles         ArticleAttachedFile[]
    ArticleAdditionalInfo ArticleAdditionalInfo?
    user                  User                   @relation(fields: [createdBy], references: [id], onDelete: NoAction)
    image                 File                   @relation(fields: [imageId], references: [id], onDelete: NoAction)
}

model ArticleAdditionalInfo {
    id           Int       @id @default(autoincrement())
    articleId    Int       @unique
    fromDateTime DateTime?
    toDateTime   DateTime?

    article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ArticleTag {
    id        Int @id @default(autoincrement())
    articleId Int
    tagId     Int
    position  Int

    article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
    tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
}

model ArticleAttachedFile {
    id           Int     @id @default(autoincrement())
    articleId    Int
    fileId       Int
    isInsideBody Boolean
    position     Int?

    article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
    file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)
}
