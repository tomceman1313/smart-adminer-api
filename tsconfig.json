{
  "compilerOptions": {
    "target": "es2016",                                  
    "module": "commonjs",                                
    "rootDir": "./src",                                
    "types": ["jest", "node", "./src/types/global"],
    "outDir": "./dist",                                 
    "esModuleInterop": true,                           
    "forceConsistentCasingInFileNames": true,          
    "strict": true,                                      
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@controllers/*": ["src/controllers/*"],
      "@services/*": ["src/services/*"],
      "@schema/*": ["src/schema/*"],
      "@routes/*": ["src/routes/*"],
      "types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["src/config/*"],
      "@mocks/*": ["src/mocks/*"],
      "@src/*": ["src/*"],
    }                               
  },
  "exclude": ["jest.config.ts", "jest.setup.ts", "tests"],
}
